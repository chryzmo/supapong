{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // The Edge Functions' entry points are Deno code, typechecked by Deno when
  // deployed; their pure modules and tests are checked here.
  "include": ["src", "tests", "vite.config.ts", "supabase/functions/*/issue.ts", "supabase/functions/*/*.test.ts"]
}
