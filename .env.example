# Copy to .env.local.  Values come from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Cloudflare's always-pass Turnstile test key, matching the test secret in
# supabase/config.toml.  Production builds use the real widget's site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
